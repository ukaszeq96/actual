+    expect(
+      parseXlsx(workbookBytes([Array(257).fill('x')])).errors[0].message,
+    ).toContain('256 columns');
+    expect(parseXlsx(workbookBytes([])).transactions).toEqual([]);
+  });
+});
diff --git a/packages/loot-core/src/server/transactions/import/xlsx.ts b/packages/loot-core/src/server/transactions/import/xlsx.ts
